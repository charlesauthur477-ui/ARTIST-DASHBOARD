# Wavelength Artist Management — environment variables
#
# Variable NAMES only below — no real values are committed to this repo.
# Copy this file to .env.local and fill in real values for local
# development; in Vercel, DATABASE_URL and BLOB_READ_WRITE_TOKEN are
# auto-populated when you add the Neon Postgres and Vercel Blob
# integrations to the project (Project Settings → Storage), for both
# Production and Preview environments.

# --- Phase 3: database (required once USE_DATABASE is not "false") --------
# Neon Postgres connection string. Provisioned via the Vercel Marketplace
# ("Storage" tab → Postgres → Neon). See PHASE_3_PLAN.md / PHASE_3_REPORT.md.
DATABASE_URL=

# Explicit override for the static-data-vs-database switch in lib/artists.ts.
# Leave unset (defaults to "true" whenever DATABASE_URL is set) once the
# database is ready. Set to "false" to force the public site back onto the
# static demo data in /data/artists even if DATABASE_URL is set — useful for
# comparing the two during migration verification.
USE_DATABASE=

# --- Phase 3: media storage ------------------------------------------------
# Vercel Blob read/write token. Provisioned via the Vercel Marketplace
# ("Storage" tab → Blob). Server-only — never exposed to the browser.
BLOB_READ_WRITE_TOKEN=

# --- Phase 4: admin dashboard -----------------------------------------------
# Auth.js session secret. Required. Generate one with:
#   npx auth secret
# (or `openssl rand -base64 33`) and keep it private -- anyone with this
# value could forge admin sessions.
AUTH_SECRET=

# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Calendar is entirely internal (Wavelength's own artist_calendar_events
# table) — no external Google/Apple calendar integration, so no calendar-
# related environment variables are required. See CALENDAR.md.

# --- Email notifications (booking flow + artist password reset) -----------
# Resend (https://resend.com) API key. Leave unset to disable outbound
# email entirely — every send is failure-tolerant: a booking or a password
# reset always succeeds even if no email is configured or a send fails.
RESEND_API_KEY=

# "From" address emails are sent as. Must be a domain verified in Resend,
# or leave unset to use the shared onboarding@resend.dev sender for testing.
# EMAIL_FROM=Wavelength <bookings@your-domain.com>

# Comma-separated admin email addresses to notify on new booking enquiries.
# Leave unset to automatically notify every active super_admin/manager
# admin account instead.
# ADMIN_NOTIFICATION_EMAIL=bookings@your-domain.com
